[Unit]
Description=LunkServer Satellite Backend Service
After=network.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/Documents/LunkfleetManager/satellite-backend
ExecStart=/home/<USER>/Documents/LunkfleetManager/satellite-backend/.venv/bin/python main.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
